# Copy to .env and fill in values. Config files name these variables;
# the values stay out of git. `vmr` loads ./.env and does not replace
# variables already set in the environment.
#
# Coding agents (query and agentic compile). AGENT_BASE_URL is optional;
# leave it empty to use the vendor endpoint.
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=

# VLM captioners (simple, dense, hierarchical, bidirectional).
VLM_MODEL=
VLM_API_KEY=
VLM_BASE_URL=
